# VehicleGPT Environment Configuration
# Copy this file to .env and modify as needed

# Database path (SQLite)
DATABASE_URL=sqlite:///./data/vehiclegpt.db

# Application settings
APP_NAME=VehicleGPT
APP_VERSION=0.1.0
DEBUG=true

# Sprint 4: AI provider (Ollama, running locally -- no API key needed)
# Run `ollama pull llama3.1:8b` once before using the AI ask endpoint.
# If Ollama is unavailable, the app falls back to deterministic explanations
# automatically -- these settings have no effect on whether the app starts.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
AI_TIMEOUT_SECONDS=20
